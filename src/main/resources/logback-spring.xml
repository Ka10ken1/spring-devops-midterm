<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>

	<property name="LOG_FILE" value="${LOG_FILE:-logs/app}"/>

	<springProfile name="docker">
		<appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
			<encoder class="net.logstash.logback.encoder.LogstashEncoder">
				<includeMdcKeyName>requestId</includeMdcKeyName>
				<includeMdcKeyName>username</includeMdcKeyName>
			</encoder>
		</appender>

		<logger name="com.spring_midterm.midterm" level="INFO"/>
		<logger name="org.springframework.security" level="WARN"/>
		<logger name="org.hibernate.SQL" level="WARN"/>

		<root level="WARN">
			<appender-ref ref="JSON_CONSOLE"/>
		</root>
	</springProfile>

	<springProfile name="prod">
		<appender name="PROD_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
			<file>${LOG_FILE}.log</file>
			<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
				<fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
				<maxFileSize>10MB</maxFileSize>
				<maxHistory>60</maxHistory>
				<totalSizeCap>500MB</totalSizeCap>
			</rollingPolicy>
			<encoder>
				<pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} | %-5level | [%thread] | %X{requestId} | %X{username} | %logger{39} | %m%n</pattern>
			</encoder>
		</appender>

		<logger name="com.spring_midterm.midterm" level="INFO"/>
		<logger name="org.springframework.security" level="WARN"/>
		<logger name="org.hibernate.SQL" level="WARN"/>

		<root level="WARN">
			<appender-ref ref="PROD_FILE"/>
		</root>
	</springProfile>

	<springProfile name="!prod">
		<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
			<encoder>
				<pattern>${CONSOLE_LOG_PATTERN:-%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%-5level) %clr(${PID:-}){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}</pattern>
			</encoder>
		</appender>

		<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
			<file>${LOG_FILE}.log</file>
			<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
				<fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
				<maxFileSize>10MB</maxFileSize>
				<maxHistory>30</maxHistory>
				<totalSizeCap>100MB</totalSizeCap>
			</rollingPolicy>
			<encoder>
				<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{39} %X{requestId} %X{username} : %m%n</pattern>
			</encoder>
		</appender>

		<appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
			<queueSize>512</queueSize>
			<discardingThreshold>0</discardingThreshold>
			<appender-ref ref="FILE"/>
		</appender>
	</springProfile>

	<springProfile name="dev">
		<logger name="com.spring_midterm.midterm" level="DEBUG"/>
		<logger name="org.springframework.security" level="DEBUG"/>
		<logger name="org.hibernate.SQL" level="DEBUG"/>

		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
			<appender-ref ref="ASYNC_FILE"/>
		</root>
	</springProfile>

	<springProfile name="!dev &amp; !prod">
		<logger name="com.spring_midterm.midterm" level="INFO"/>
		<logger name="org.springframework.security" level="INFO"/>

		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
			<appender-ref ref="ASYNC_FILE"/>
		</root>
	</springProfile>

</configuration>
